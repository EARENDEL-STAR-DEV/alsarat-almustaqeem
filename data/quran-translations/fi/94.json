{"edition":"fin-unknown","surah":94,"ayahCount":8,"ayahs":{"1":"Emmekö Me ole avartanut rintaasi","2":"Emmekö ole sinulta ottanut pois kuormasi","3":"joka raskaana painoi hartioillasi","4":"ja korottanut sinun arvoasi","5":"Totisesti, helpotus seuraa vastuksia","6":"ja vastoinkäymistä seuraa huojennus","7":"Kun siis olet vapaa työstä, rukoile ahkerasti","8":"ja palvele Herraasi koko sydämestäsi"}}